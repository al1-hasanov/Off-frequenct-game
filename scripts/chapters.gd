const ACTS := ["Prologue", "Act 1", "Act 2", "Act 3"]


static func find(id: String) -> Dictionary:
	for ch in LIST:
		if ch.id == id:
			return ch
	return {}


static func in_act(act: String) -> Array:
	return LIST.filter(func(ch: Dictionary) -> bool: return ch.act == act)


## 0: no choices made yet. 1: depends on Choice 1. 2: depends on both choices.
static func needs(id: String) -> int:
	var all: Dictionary = ChapterStates.STATES.get(id, {})
	if all.has("answer_take"):
		return 2
	if all.has("answer"):
		return 1
	return 0


## The story state the chapter starts from (empty for P1: a new game).
static func state(id: String, answered: bool, took_tomas: bool) -> Dictionary:
	var all: Dictionary = ChapterStates.STATES.get(id, {})
	if all.is_empty():
		return {}
	var key := "any"
	match needs(id):
		1:
			key = "answer" if answered else "cut"
		2:
			key = ("answer" if answered else "cut") + ("_take" if took_tomas else "_leave")
	return (all[key] as Dictionary).duplicate(true)
